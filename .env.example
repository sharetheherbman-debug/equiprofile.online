# ==============================================================================
# EQUIPROFILE PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control
# ==============================================================================

# ==========================================
# CORE CONFIGURATION (Always Required)
# ==========================================

# Application Settings
NODE_ENV=production
PORT=3000
HOST=127.0.0.1

# Management base URL (required for OAuth redirects and Management links)
BASE_URL=https://equiprofile.online
# Canonical Core hosts served by this one backend/database.
MANAGEMENT_BASE_URL=https://equiprofile.online
ACADEMY_BASE_URL=https://academy.equiprofile.online
SHOP_BASE_URL=https://shop.equiprofile.online
# Legacy compatibility host only; reverse proxy must redirect it to Academy.
LEGACY_SCHOOL_BASE_URL=https://school.equiprofile.online
# Shared authentication session scope across the Core hosts.
COOKIE_DOMAIN=.equiprofile.online
COOKIE_SECURE=true
# Comma-separated trusted browser origins for Core CORS checks.
TRUSTED_ORIGINS=https://equiprofile.online,https://academy.equiprofile.online,https://shop.equiprofile.online

# ==========================================
# Database Configuration
# ==========================================
# Format: mysql://username:password@host:port/database
DATABASE_URL=mysql://equiprofile:password@localhost:3306/equiprofile

# ==========================================
# Authentication & Security
# ==========================================

# JWT Secret (generate with: openssl rand -base64 32)
# CRITICAL: Must be at least 32 characters, randomly generated
JWT_SECRET=your_jwt_secret_here_generate_with_openssl

# Admin Unlock Password
# CRITICAL: MUST be changed in production
# Application will refuse to start with weak passwords in production
# SECURITY: For enhanced security, you can store this as a bcrypt hash
#   Example plaintext: MySecureAdminPass123!
#   Example bcrypt hash: $2b$10$abcdefghijklmnopqrstuvwxyz1234567890ABCDEF
#   Generate hash with: node -e "console.log(require('bcrypt').hashSync('YourPassword', 10))"
ADMIN_UNLOCK_PASSWORD=YOUR_SECURE_ADMIN_PASSWORD_HERE
# Optional: email address that is automatically granted admin role on first login.
# Leave blank (or unset) to disable automatic admin promotion.
PRIMARY_ADMIN_EMAIL=

# ==========================================
# FEATURE FLAGS (Enable/Disable Features)
# ==========================================

# Enable Stripe billing and subscriptions
# Set to 'true' to enable, 'false' or leave empty to disable
ENABLE_STRIPE=false

# Enable document uploads and storage
# Set to 'true' to enable, 'false' or leave empty to disable
ENABLE_UPLOADS=false

# Enable PWA service worker (server-side flag, used in vite.config.ts build)
# Set to 'true' to enable, 'false' or leave empty to disable
# Default: false (disabled for simple deployment)
ENABLE_PWA=true

# ==========================================
# OAUTH CONFIGURATION (Optional)
# ==========================================

# OAuth Server URL - URL of the OAuth authorization server
# Leave empty to disable OAuth login (email/password auth still works)
OAUTH_SERVER_URL=

# OAuth Application ID - The client ID registered with the OAuth server
# Required if OAUTH_SERVER_URL is set
VITE_APP_ID=

# Owner OpenID - OpenID of the application owner (for admin access)
# If set, this user automatically gets admin role
OWNER_OPEN_ID=

# ==========================================
# STRIPE CONFIGURATION (Required if ENABLE_STRIPE=true)
# ==========================================
# Get from https://dashboard.stripe.com

# Stripe keys
# STRIPE_SECRET_KEY=sk_live_xxxxx
# STRIPE_PUBLISHABLE_KEY=pk_live_xxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# Stripe price IDs for subscription plans
# Pro Plan (up to 5 horses)
# STRIPE_MONTHLY_PRICE_ID=price_xxxxx
# STRIPE_YEARLY_PRICE_ID=price_xxxxx

# Stable Plan (up to 20 horses, team features)
# STRIPE_STABLE_MONTHLY_PRICE_ID=price_xxxxx
# STRIPE_STABLE_YEARLY_PRICE_ID=price_xxxxx

# Academy organisation billing — isolated Stripe TEST mode only; no live charge.
# The implementation fails closed unless all required Academy TEST values are set.
# ENABLE_ACADEMY_BILLING=false
# ACADEMY_STRIPE_TEST_MODE=true
# ACADEMY_STRIPE_SECRET_KEY=sk_test_xxxxx
# ACADEMY_STRIPE_WEBHOOK_SECRET=whsec_xxxxx
# ACADEMY_STRIPE_SCHOOL_10_MONTHLY_PRICE_ID=price_xxxxx
# ACADEMY_STRIPE_SCHOOL_10_YEARLY_PRICE_ID=price_xxxxx
# ACADEMY_STRIPE_SCHOOL_20_MONTHLY_PRICE_ID=price_xxxxx
# ACADEMY_STRIPE_SCHOOL_20_YEARLY_PRICE_ID=price_xxxxx
# ACADEMY_STRIPE_SCHOOL_50_MONTHLY_PRICE_ID=price_xxxxx
# ACADEMY_STRIPE_SCHOOL_50_YEARLY_PRICE_ID=price_xxxxx
# ACADEMY_STRIPE_ENTERPRISE_MONTHLY_PRICE_ID=price_xxxxx
# ACADEMY_STRIPE_ENTERPRISE_YEARLY_PRICE_ID=price_xxxxx
# ACADEMY_STRIPE_BILLING_PORTAL_CONFIGURATION_ID=bpc_xxxxx
# ACADEMY_PUBLIC_URL=https://academy.equiprofile.online

# Store commerce payments (keep separate from SaaS/Academy billing credentials).
# ENABLE_STORE_STRIPE=false
# STORE_STRIPE_SECRET_KEY=sk_test_xxxxx
# STORE_STRIPE_WEBHOOK_SECRET=whsec_xxxxx
# STORE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx

# ==========================================
# UPLOAD/STORAGE CONFIGURATION (Required if ENABLE_UPLOADS=true)
# ==========================================

# Storage Proxy API (for document uploads via proxy service)
# STORAGE_PROXY_URL=https://your-storage-proxy.com
# STORAGE_PROXY_KEY=your_storage_proxy_key

# Local disk storage path (used when ENABLE_UPLOADS=false or proxy is not configured)
# IMPORTANT: In Docker, set this to /app/uploads and mount a named volume there
#   so uploaded files survive container restarts and image upgrades.
#   See docker-compose.yml — the uploads_data volume is pre-configured for this.
# Default (production): /var/www/equiprofile/uploads
# Default (development): ./uploads
# STORAGE_PATH=/app/uploads

# AWS S3 Configuration (legacy - alternative to proxy storage)
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION=eu-west-2
# AWS_S3_BUCKET=equiprofile-uploads

# ==========================================
# PWA (Progressive Web App) CONFIGURATION
# ==========================================

# Enable PWA service worker (client-side Vite flag, must match ENABLE_PWA above)
# Both ENABLE_PWA and VITE_PWA_ENABLED must be true for PWA to work
# Default: false (disabled for simple deployment)
VITE_PWA_ENABLED=true

# ==========================================
# OPTIONAL FEATURES
# ==========================================

# Provider-neutral Core AI / GenX contract. Academy Tutor and other Core AI
# features call the server-side Core abstraction only; never expose these values
# in browser variables. All three values are required when AI is enabled.
# CORE_AI_PROVIDER=genx
# CORE_AI_BASE_URL=https://your-approved-core-ai-provider.example/v1
# CORE_AI_API_KEY=replace_with_secret_from_provider
# CORE_AI_MODEL=provider-approved-model-id

# Optional: Maps proxy for the ride-tracking / GPS map view
# VITE_MAPS_PROXY_URL=https://your-maps-proxy.com
# VITE_MAPS_API_KEY=your_maps_key

# Email Configuration (SMTP - for notifications and Contact form)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM=noreply@equiprofile.online
# Academy invitation emails use ACADEMY_BASE_URL and record DELIVERED/FAILED
# status server-side. SMTP absence is an external configuration blocker, never a success.

# Contact form destination address (defaults to SMTP_FROM if not set)
# CONTACT_TO=support@equiprofile.online

# ==========================================
# WHATSAPP CONFIGURATION (Optional — Twilio)
# ==========================================
# Send WhatsApp reminders via Twilio's WhatsApp API.
# When disabled (default), the reminder scheduler skips WhatsApp silently.
#
# Credentials can also be saved via Admin → WhatsApp (stored in DB siteSettings).
# Environment variables take priority over database settings.

# Set to 'true' to enable WhatsApp notifications
ENABLE_WHATSAPP=false

# Twilio Account SID — from Twilio Console → Account Info
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Twilio Auth Token — from Twilio Console → Account Info
# TWILIO_AUTH_TOKEN=your_auth_token

# WhatsApp sender number in whatsapp:+E.164 format
# Use Twilio Sandbox number for testing, or your approved Business number for production
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ==========================================
# SECURITY & REVERSE PROXY
# ==========================================

# Rate Limiting Configuration
# Default: 500 requests per 15 minutes per IP (increased from 100 for authenticated dashboard use)
# Consider 1000 for high-traffic production deployments
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500

# Cookie Security (Important when behind reverse proxy)
# Set to your domain for production. Use leading dot for subdomain coverage.
# COOKIE_DOMAIN and COOKIE_SECURE are declared in the canonical-host section above.

# ==========================================
# LOGGING
# ==========================================

# Log level (error, warn, info, debug)
LOG_LEVEL=info

# Log file path (ensure directory exists and is writable)
# LOG_FILE_PATH=/var/log/equiprofile/app.log

# ==========================================
# BUILD CONFIGURATION (for build endpoints)
# ==========================================

# Build ID (auto-generated during build)
# BUILD_ID=abc123

# Build timestamp (auto-generated during build)
# BUILD_TIME=2026-01-07T12:00:00.000Z

# ==========================================
# SALES CHAT WIDGET
# ==========================================

# Secret key to access the /api/sales-leads admin endpoint
# Set to a long random string; keep private
# ADMIN_LEADS_KEY=your_secret_random_key_here

# ==========================================
# FRONTEND VERSION (Deploy-Time Selection)
# ==========================================

# Current Core frontend contract. Do not deploy the obsolete v1 frontend.
VITE_UI_VERSION=v2

# ==========================================
# SUPPLIER ONBOARDING (server-side only)
# ==========================================
# Leave supplier credentials unset until the trade agreement, permitted feed/API
# access and image rights are approved. Avasam remains NOT CONFIGURED without them.
# AVASAM_API_KEY=
# STABLE_ENVIRONMENT_TRADE_ACCOUNT_ID=
# EQUETECH_TRADE_ACCOUNT_ID=

# ==========================================
# CORE → STANDALONE MARKETING APPLICATION CONNECTOR (server-side only)
# ==========================================
# Core uses the same canonical Application Connector contract as standalone
# Marketing: X-Application-Id/Key/Timestamp/Nonce/Signature with a canonical
# HMAC-SHA256 body signature. Marketing outages are failure-contained and must
# never block Core transactions. Never expose the connector key to browser code.
#
# These values must match the connector configured in AmarktAI Marketing.
# MARKETING_APP_URL=https://marketing.equiprofile.online
# MARKETING_API_URL=https://marketing.equiprofile.online/api/v1
# HOST_APP_ID=equiprofile
# HOST_APP_CONNECTOR_KEY=replace_with_32_plus_character_shared_connector_key
# Compatibility aliases accepted by Core:
# EQUIPROFILE_APP_ID=equiprofile
# EQUIPROFILE_CONNECTOR_KEY=replace_with_32_plus_character_shared_connector_key
# MARKETING_CONNECTOR_TIMEOUT_MS=3000
